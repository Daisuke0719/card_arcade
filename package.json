{
  "name": "card-arcade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Claude Code × GitHub 共同開発ハンズオン — みんなでつくる CARD ARCADE",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "scope": "node scripts/scope-guard.mjs",
    "verify": "npm run scope && npm run lint && npm run typecheck && npm run test && npm run build && node scripts/mark-verified.mjs",
    "scaffold": "node scripts/scaffold-game.mjs",
    "role": "node scripts/role.mjs",
    "doctor": "node scripts/doctor.mjs",
    "status": "node scripts/status.mjs",
    "online:registry": "node scripts/generate-online-registry.mjs",
    "online:dev": "wrangler dev",
    "online:deploy:staging": "wrangler deploy --env staging",
    "online:deploy:production": "wrangler deploy --env production",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
