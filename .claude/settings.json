{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "保護領域（src/core など）の判定は .claude/hooks/guard-scope.mjs が行う。permissions.deny は静的なリストで、講師と参加者で振る舞いを変えられない（deny は全設定ファイルの和集合で、上位のファイルからも打ち消せない）ため。ここに残す deny は、ロールに関係なく止めたいものだけ。保護されている場所の正本は harness/config.json の protectedPaths。",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm uninstall *)",
      "Bash(npm remove *)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(bun add *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git config core.hooksPath *)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm run preview)",
      "Bash(npm run preview *)",
      "Bash(npm run test:watch)",
      "Bash(npm run test:watch *)",
      "Bash(npx vite *)",
      "Bash(npx vitest *)",
      "Bash(vite *)",
      "Bash(vitest *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue comment *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue create *)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git restore *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(npm -v)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh auth status *)",
      "Bash(git config core.hooksPath)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(node scripts/doctor.mjs)",
      "Bash(node scripts/scope-guard.mjs)",
      "Bash(node scripts/scope-guard.mjs *)",
      "Bash(node scripts/status.mjs)",
      "Bash(node scripts/ci-summary.mjs)",
      "Bash(node scripts/check-pr-body.mjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-scope.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-file.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-brief.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/require-verify.mjs"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.mjs"
  }
}
